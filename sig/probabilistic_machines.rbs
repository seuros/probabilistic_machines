# Sketches that answer a counting question in memory fixed at construction
# time. Every sketch class is defined by the native extension.
#
# Sizes come from a fixed menu (a class constant); anything else raises
# RangeError, a non-Integer TypeError. A call the core refuses answers the
# snake_case symbol of its `Refusal` variant, changes nothing and never raises.
# No answer depends on, or records, a clock.
module ProbabilisticMachines
  VERSION: String

  # Every refusal the crate answers.
  type refusal = :truncated | :wrong_structure | :wrong_shape | :malformed | :full
               | :overflow | :zero_count | :not_finite | :invalid_weight

  # What `decode` refuses: a frame cut short, another structure's frame, a frame
  # of another shape, or contents no sketch produces.
  type decode_refusal = :truncated | :wrong_structure | :wrong_shape | :malformed

  # The core's `Hitter`. The true count lies in `count - overestimate` through
  # `count`. Raises RangeError unless `overestimate < count` (both in
  # `0...2**64`), TypeError for a non-String key or a non-Integer count.
  class Hitter < ::Data
    attr_reader key: String
    attr_reader count: Integer
    attr_reader overestimate: Integer

    def self.new: (String key, Integer count, Integer overestimate) -> instance
                | (key: String, count: Integer, overestimate: Integer) -> instance
  end

  # The core's `Centroid`: one cluster of a digest. Raises RangeError unless
  # the mean is finite and the weight finite and positive, TypeError for a
  # non-number. Stored as Floats.
  class Centroid < ::Data
    attr_reader mean: Float
    attr_reader weight: Float

    def self.new: (Float | Integer mean, Float | Integer weight) -> instance
                | (mean: Float | Integer, weight: Float | Integer) -> instance
  end

  # Distinct counts in a fixed register array.
  class HyperLogLog
    REGISTERS: Array[Integer]

    # RangeError outside REGISTERS.
    def self.new: (Integer registers) -> instance

    # `:wrong_shape` for a register count this build does not carry.
    def self.decode: (String bytes) -> (instance | decode_refusal)

    # Reads a frame of this sketch's register count over it.
    def decode_into: (String bytes) -> (:decoded | decode_refusal)

    def registers: () -> Integer
    def add: (String item) -> nil

    # For streams that ship 64-bit hashes instead of keys.
    def add_hash: (Integer hash) -> nil

    def estimate: () -> Float

    # Relative standard error of the estimate, `1.04 / sqrt(registers)`.
    def standard_error: () -> Float

    def empty?: () -> bool

    # Exact union. `:wrong_shape` for another register count.
    def merge: (HyperLogLog other) -> (:merged | :wrong_shape)

    def encoded: () -> String
    def inspect: () -> String
  end

  # How often each item was seen, in `width * depth` counters.
  class CountMinSketch
    WIDTHS: Array[Integer]
    DEPTHS: Array[Integer]

    # RangeError outside WIDTHS by DEPTHS; every pair is carried.
    def self.new: (Integer width, Integer depth) -> instance

    def self.decode: (String bytes) -> (instance | decode_refusal)
    def decode_into: (String bytes) -> (:decoded | decode_refusal)

    def width: () -> Integer
    def depth: () -> Integer

    # `:overflow` when one of the item's counters would pass `2**32 - 1`.
    def add: (String item) -> (:added | :overflow)

    # `count` is in `0...2**32` (RangeError otherwise); zero is `:zero_count`.
    def add_count: (String item, Integer count) -> (:added | :zero_count | :overflow)

    def add_hash_count: (Integer hash, Integer count) -> (:added | :zero_count | :overflow)

    # Never below the true count, and over it by at most
    # `e * total / width` with probability `1 - e ** -depth`.
    def estimate: (String item) -> Integer

    def estimate_hash: (Integer hash) -> Integer

    # Sum of every count added.
    def total: () -> Integer

    # Exact sum. `:wrong_shape` for another width or depth.
    def merge: (CountMinSketch other) -> (:merged | :overflow | :wrong_shape)

    def encoded: () -> String
    def inspect: () -> String
  end

  # Quantiles of a stream, in clusters instead of samples.
  class TDigest
    MIN_COMPRESSION: Integer

    # RangeError below MIN_COMPRESSION or past 65535.
    def self.new: (Integer compression) -> instance

    def self.decode: (String bytes) -> (instance | :truncated | :wrong_structure | :malformed)

    def compression: () -> Integer

    def add: (Float | Integer value) -> (:added | :not_finite | :overflow)

    # One value standing for `weight` observations.
    def add_weighted: (Float | Integer value, Float | Integer weight)
                    -> (:added | :not_finite | :invalid_weight | :overflow)

    # Value at quantile `q`, `Float::NAN` when empty.
    def quantile: (Float q) -> Float

    # Fraction of the stream at or below `value`, `Float::NAN` when empty.
    def cdf: (Float value) -> Float

    # Total weight added.
    def count: () -> Float

    # Smallest value added, `Float::INFINITY` when empty.
    def minimum: () -> Float

    # Largest value added, `-Float::INFINITY` when empty.
    def maximum: () -> Float

    # Clusters currently held.
    def size: () -> Integer

    def empty?: () -> bool
    def centroids: () -> Array[Centroid]

    # Collapses adjacent clusters up to the weight their quantile allows.
    def compress: () -> nil

    # `:wrong_shape` for a digest of another compression.
    def merge: (TDigest other) -> (:merged | :wrong_shape | :overflow)

    def encoded: () -> String
    def inspect: () -> String
  end

  # Membership that can forget, in `buckets * 4` fingerprints.
  class CuckooFilter
    BUCKETS: Array[Integer]

    # RangeError outside BUCKETS.
    def self.new: (Integer buckets) -> instance

    def self.decode: (String bytes) -> (instance | :truncated | :wrong_structure | :wrong_shape)
    def decode_into: (String bytes) -> (:decoded | :truncated | :wrong_structure | :wrong_shape)

    def buckets: () -> Integer

    # Fingerprint slots in the table, `buckets * 4`.
    def capacity: () -> Integer

    # Stores one more copy of the item's fingerprint.
    def insert: (String item) -> (:inserted | :full)

    def insert_hash: (Integer hash) -> (:inserted | :full)

    # Never false for an item that was inserted; true for one that was not
    # with probability about 3%.
    def contains?: (String item) -> bool

    def contains_hash?: (Integer hash) -> bool

    # `:cleared` clears one copy of the item's fingerprint, which may have
    # been a colliding item's: only remove what you inserted. `:not_held`
    # proves the fingerprint is in neither bucket; nothing changed.
    def remove: (String item) -> (:cleared | :not_held)

    def remove_hash: (Integer hash) -> (:cleared | :not_held)

    def size: () -> Integer
    def empty?: () -> bool
    def encoded: () -> String
    def inspect: () -> String
  end

  # Which keys dominate a stream, in a fixed number of counters.
  class HeavyHitters
    COUNTERS: Array[Integer]

    # RangeError outside COUNTERS.
    def self.new: (Integer counters) -> instance

    # `:malformed` also covers a key table that is cut short or does not name
    # every tracked key.
    def self.decode: (String bytes) -> (instance | decode_refusal)
    def decode_into: (String bytes) -> (:decoded | decode_refusal)

    def counters: () -> Integer

    # Keys are UTF-8 strings, so the Hitter values can hand them back.
    def add: (String key) -> (:added | :overflow)

    # `count` is in `0...2**64` (RangeError otherwise); zero is `:zero_count`.
    def add_count: (String key, Integer count) -> (:added | :zero_count | :overflow)

    # Upper bound on how often `key` occurred, 0 when it is not tracked.
    def count: (String key) -> Integer

    # Observations fed in.
    def observed: () -> Integer

    # Keys currently tracked, at most `counters`.
    def size: () -> Integer

    def empty?: () -> bool

    # The most frequent tracked key, nil when nothing is tracked.
    def top: () -> Hitter?

    # Every tracked key, most frequent first.
    def ranked: () -> Array[Hitter]

    # Every tracked key, in the table's own order.
    def hitters: () -> Array[Hitter]

    # `:wrong_shape` for another counter count.
    def merge: (HeavyHitters other) -> (:merged | :overflow | :wrong_shape)

    # The crate's frame followed by the key table that carries the strings.
    def encoded: () -> String

    def inspect: () -> String
  end
end
